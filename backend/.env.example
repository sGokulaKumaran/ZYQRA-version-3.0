# Copy this file to ".env" (same folder). You only need ONE provider key to start.
#
# The easy way: leave the keys empty and add them in the app under
# Settings > AI models - they are saved into this file for you, along with
# the key of any other provider you add there.
#
# Tip: one variable may hold several keys separated by commas
#      (GEMINI_API_KEY=key1,key2) - each is tried in turn.
# Changes to this file are picked up while the server is running.

# --- AI providers ---------------------------------------------------------
# Google Gemini            https://aistudio.google.com/apikey
GEMINI_API_KEY=            

# Groq                     https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM               https://build.nvidia.com
NVIDIA_API_KEY=

# Mistral AI               https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenRouter               https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare Workers AI    https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- App ------------------------------------------------------------------
# Signs login tokens. Leave empty to have one generated and stored for you.
SECRET_KEY=

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Days a login stays valid.
ACCESS_TOKEN_DAYS=7

# --- Administrator --------------------------------------------------------
# The admin signs in with this username and password. Choose the password
# yourself (at least 8 characters); the account is created or updated the
# next time you sign in - no restart needed. Leave the password empty and
# there is no admin account. Put it in "quotes" if it contains spaces or #.
ADMIN_USERNAME=admin@zyqra.com
ADMIN_PASSWORD=
